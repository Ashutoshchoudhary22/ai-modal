# AI Platform — Environment Template
# Copy to .env and adjust values

# Application
AI_PLATFORM_ENV=development
AI_PLATFORM_DEBUG=true
AI_PLATFORM_LOG_LEVEL=INFO
AI_PLATFORM_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars

# Database
AI_PLATFORM_DATABASE_URL=mysql+pymysql://root:@localhost:3306/aiplatform
AI_PLATFORM_DATABASE_POOL_SIZE=10

# Redis
AI_PLATFORM_REDIS_URL=redis://localhost:6379/0

# AI API
AI_PLATFORM_AI_API_HOST=0.0.0.0
AI_PLATFORM_AI_API_PORT=8000

# Agent
AI_PLATFORM_AGENT_HOST=0.0.0.0
AI_PLATFORM_AGENT_PORT=8001
AI_PLATFORM_AGENT_MAX_ITERATIONS=25
AI_PLATFORM_AGENT_TOOL_TIMEOUT_SEC=120

# Coding Agent Tools (Phase 5)
AI_PLATFORM_TOOLS_ENABLED=true
AI_PLATFORM_TOOL_MAX_FILE_SIZE=1048576
AI_PLATFORM_TOOL_MAX_OUTPUT=32000
AI_PLATFORM_TERMINAL_ENABLED=true
AI_PLATFORM_TERMINAL_TIMEOUT=120
AI_PLATFORM_TERMINAL_MAX_OUTPUT=32000
AI_PLATFORM_TOOL_WRITE_ENABLED=true

# Model Provider (development_mock | mock | local | proprietary)
AI_PLATFORM_MODEL_PROVIDER=development_mock
AI_PLATFORM_DEFAULT_MODEL=development-mock-v1

# Local model settings (when AI_PLATFORM_MODEL_PROVIDER=local)
AI_PLATFORM_MODEL_ID=
AI_PLATFORM_MODEL_PATH=
AI_PLATFORM_MODEL_DEVICE=auto
AI_PLATFORM_MODEL_DTYPE=auto
AI_PLATFORM_MODEL_MAX_CONTEXT=4096
AI_PLATFORM_MODEL_TRUST_REMOTE_CODE=false
AI_PLATFORM_MODEL_GENERATION_TIMEOUT_SEC=120
AI_PLATFORM_MODEL_GENERATION_MAX_TOKENS=1024
AI_PLATFORM_MODEL_GENERATION_TEMPERATURE=0.7
AI_PLATFORM_MODEL_GENERATION_TOP_P=1.0

# Security
AI_PLATFORM_RATE_LIMIT_RPM=60
AI_PLATFORM_JWT_EXPIRY_MINUTES=60
AI_PLATFORM_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Training
AI_PLATFORM_TRAINING_OUTPUT_DIR=./models/finetuned
AI_PLATFORM_WANDB_ENABLED=false
