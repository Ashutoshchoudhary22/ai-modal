# AI Platform — Environment Template
# Copy to .env and adjust values

# Application
AI_PLATFORM_ENV=development
AI_PLATFORM_DEBUG=true
AI_PLATFORM_LOG_LEVEL=INFO
AI_PLATFORM_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars

# Database
AI_PLATFORM_DATABASE_URL=mysql+pymysql://root:@localhost:3306/aiplatform
AI_PLATFORM_DATABASE_POOL_SIZE=10

# Redis
AI_PLATFORM_REDIS_URL=redis://localhost:6379/0

# AI API
AI_PLATFORM_AI_API_HOST=0.0.0.0
AI_PLATFORM_AI_API_PORT=8000

# Agent
AI_PLATFORM_AGENT_HOST=0.0.0.0
AI_PLATFORM_AGENT_PORT=8001
AI_PLATFORM_AGENT_ENABLED=true
AI_PLATFORM_AGENT_MAX_ITERATIONS=25
AI_PLATFORM_AGENT_MAX_TOOL_CALLS=50
AI_PLATFORM_AGENT_MAX_SAME_TOOL_CALLS=10
AI_PLATFORM_AGENT_MAX_MODEL_CALLS=30
AI_PLATFORM_AGENT_MAX_RUNTIME=600
AI_PLATFORM_AGENT_MAX_CONTEXT_CHARS=32000
AI_PLATFORM_AGENT_MAX_TOOL_RESULT_CHARS=8000
AI_PLATFORM_AGENT_MAX_RETRIES=3
AI_PLATFORM_AGENT_DEFAULT_POLICY=coding
AI_PLATFORM_AGENT_TOOL_TIMEOUT_SEC=120

# Screenshot-to-Code (Phase 8)
AI_PLATFORM_SCREENSHOT_TO_CODE_ENABLED=true
AI_PLATFORM_VISION_PROVIDER=development_mock
AI_PLATFORM_VISION_MODEL=
AI_PLATFORM_VISION_MAX_IMAGE_BYTES=10485760
AI_PLATFORM_VISION_MAX_WIDTH=4096
AI_PLATFORM_VISION_MAX_HEIGHT=4096
AI_PLATFORM_VISION_MAX_PIXELS=16777216
AI_PLATFORM_VISION_TIMEOUT_SEC=120
AI_PLATFORM_UI_RENDERER=development_mock
AI_PLATFORM_UI_RENDER_TIMEOUT_SEC=120
AI_PLATFORM_VISUAL_VALIDATION_ENABLED=true
AI_PLATFORM_VISUAL_VALIDATION_THRESHOLD=0.85
AI_PLATFORM_VISUAL_MAX_ITERATIONS=3

# Multimodal Model (Phase 10)
AI_PLATFORM_MULTIMODAL_PROVIDER=development_mock
AI_PLATFORM_MULTIMODAL_MODEL=
AI_PLATFORM_MULTIMODAL_MAX_IMAGES=4
AI_PLATFORM_MULTIMODAL_MAX_PIXELS=16777216
AI_PLATFORM_MULTIMODAL_MAX_BATCH_SIZE=8
AI_PLATFORM_MULTIMODAL_MAX_CONTEXT_TOKENS=8192
AI_PLATFORM_MULTIMODAL_MAX_OUTPUT_TOKENS=4096
AI_PLATFORM_MULTIMODAL_TIMEOUT_SEC=120
AI_PLATFORM_MULTIMODAL_DEVICE=auto
AI_PLATFORM_MULTIMODAL_DTYPE=auto
AI_PLATFORM_VISION_USE_MULTIMODAL=false

# Multimodal Training (Phase 11)
# Training is config-driven via training/configs/multimodal/sft.yaml
# CLI: python -m training.multimodal.train --config training/configs/multimodal/sft.yaml

# Browser Agent (Phase 9)
AI_PLATFORM_BROWSER_ENABLED=true
AI_PLATFORM_BROWSER_PROVIDER=development_mock
AI_PLATFORM_BROWSER_HEADLESS=true
AI_PLATFORM_BROWSER_TIMEOUT_SEC=120
AI_PLATFORM_BROWSER_NAVIGATION_TIMEOUT_SEC=30
AI_PLATFORM_BROWSER_ACTION_TIMEOUT_SEC=15
AI_PLATFORM_BROWSER_MAX_SESSIONS=10
AI_PLATFORM_BROWSER_MAX_PAGES=3
AI_PLATFORM_BROWSER_MAX_ACTIONS=50
AI_PLATFORM_BROWSER_MAX_NAVIGATIONS=20
AI_PLATFORM_BROWSER_MAX_SCREENSHOTS=10
AI_PLATFORM_BROWSER_MAX_RUNTIME_SEC=600
AI_PLATFORM_BROWSER_MAX_ITERATIONS=25
AI_PLATFORM_BROWSER_SCREENSHOT_MAX_BYTES=5242880
AI_PLATFORM_BROWSER_ALLOWED_DOMAINS=
AI_PLATFORM_BROWSER_BLOCKED_DOMAINS=
AI_PLATFORM_BROWSER_ALLOW_LOCALHOST=true
AI_PLATFORM_BROWSER_MAX_VISIBLE_TEXT_CHARS=8000
AI_PLATFORM_BROWSER_MAX_ELEMENTS=100
AI_PLATFORM_BROWSER_MAX_OBSERVATION_CHARS=16000

# UI Generation (Phase 7)
AI_PLATFORM_UI_GENERATION_ENABLED=true
AI_PLATFORM_UI_MAX_CONTEXT_CHARS=24000
AI_PLATFORM_UI_MAX_FILES=40
AI_PLATFORM_UI_MAX_COMPONENTS=30
AI_PLATFORM_UI_DEFAULT_VALIDATION=build
AI_PLATFORM_UI_MAX_GENERATION_FILES=20

# Coding Agent Tools (Phase 5)
AI_PLATFORM_TOOLS_ENABLED=true
AI_PLATFORM_TOOL_MAX_FILE_SIZE=1048576
AI_PLATFORM_TOOL_MAX_OUTPUT=32000
AI_PLATFORM_TERMINAL_ENABLED=true
AI_PLATFORM_TERMINAL_TIMEOUT=120
AI_PLATFORM_TERMINAL_MAX_OUTPUT=32000
AI_PLATFORM_TOOL_WRITE_ENABLED=true

# Model Provider (development_mock | mock | local | proprietary)
AI_PLATFORM_MODEL_PROVIDER=development_mock
AI_PLATFORM_DEFAULT_MODEL=development-mock-v1

# Local model settings (when AI_PLATFORM_MODEL_PROVIDER=local)
AI_PLATFORM_MODEL_ID=
AI_PLATFORM_MODEL_PATH=
AI_PLATFORM_MODEL_DEVICE=auto
AI_PLATFORM_MODEL_DTYPE=auto
AI_PLATFORM_MODEL_MAX_CONTEXT=4096
AI_PLATFORM_MODEL_TRUST_REMOTE_CODE=false
AI_PLATFORM_MODEL_GENERATION_TIMEOUT_SEC=120
AI_PLATFORM_MODEL_GENERATION_MAX_TOKENS=1024
AI_PLATFORM_MODEL_GENERATION_TEMPERATURE=0.7
AI_PLATFORM_MODEL_GENERATION_TOP_P=1.0

# Security
AI_PLATFORM_RATE_LIMIT_RPM=60
AI_PLATFORM_JWT_EXPIRY_MINUTES=60
AI_PLATFORM_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Training
AI_PLATFORM_TRAINING_OUTPUT_DIR=./models/finetuned
AI_PLATFORM_WANDB_ENABLED=false
